# Copy to .env.local for local development.
#
# Public base URL of the R2 bucket holding artefacts too large for Cloudflare
# Workers static assets (25 MiB per file). Currently just
# bogota_segments.geojson at ~55 MB. Not a secret — this is a public bucket
# URL, and the underlying data is City of Bogota open data.
#
# When unset, datasets with a `remoteKey` fall back to their same-origin
# `dataUrl` under public/data, so local development works without it.
NEXT_PUBLIC_R2_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Optional: point the frontend at a running FastAPI backend instead of the
# static files. Leave unset for the static deployment.
# NEXT_PUBLIC_API_URL=http://localhost:8000
