# Imagery scoring
scoring/.env
scoring/.venv/
# Cached Street View JPEGs are never committed — Google's terms restrict
# storing panoramas. Derived JSON results ARE committed: they are the
# reproducible record and contain no imagery.
scoring/results/images/
scoring/validation.csv
scoring/**/__pycache__/
