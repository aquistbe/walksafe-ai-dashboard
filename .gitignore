# Source data for the build scripts.
#
# The small analysis tables (~470 KB total) ARE committed — they make the
# build reproducible from a clean clone. Large raw geometry is not; its
# provenance and checksum are recorded in data/source/README.md so anyone
# can obtain and verify the same input.
# Large source tables. The small analysis CSVs (~470 KB) are committed; this
# one is 12 MB, so it is treated like the raw geometry — checksummed in
# data/source/README.md rather than stored.
data/source/wt_mean_ses_calle_*.csv
data/source/*.geojson
data/source/*.zip
data/source/*.gpkg
data/source/*.shp
data/source/*.shx
data/source/*.dbf

# Imagery scoring
scoring/.env
scoring/.venv/
# Cached Street View JPEGs are never committed — Google's terms restrict
# storing panoramas. Derived JSON results ARE committed: they are the
# reproducible record and contain no imagery.
scoring/results/images/
scoring/validation.csv
scoring/**/__pycache__/
