# Next.js
frontend/.next/
frontend/out/
frontend/.preview/

# Copied from data/ by `npm run copy-data` (runs automatically before
# dev and build). Committing it would duplicate ~10 MB on every update.
frontend/public/data/

# Pipeline intermediates and deliverables. The code IS committed (pipeline/),
# and so is pipeline/data/ (small inputs that cannot be regenerated). Generated
# artefacts are not — the derived layers the dashboard consumes live in data/.
pipeline/work/
pipeline/outputs/

# Served from R2, not from the repo or the site origin: ~55 MB, over
# Cloudflare Workers' 25 MiB per-asset limit. Rebuild with
# `make bogota-segments` and publish with `make upload-bogota-segments`.
data/bogota_segments.geojson

